[Unit]
Description=GolfAdmin FastAPI backend
After=network.target

[Service]
Type=notify
User=golf
Group=golf
WorkingDirectory=/opt/golf/backend
EnvironmentFile=/opt/golf/.env
ExecStart=/opt/golf/backend/venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 4 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    --timeout 60
Restart=on-failure
RestartSec=5s
# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/golf/data
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
