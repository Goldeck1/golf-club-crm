# GolfAdmin v2 — production environment
# Copy to .env and fill in real values before `docker compose up`.

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_TO_64_RANDOM_HEX_CHARS

# SQLite (default) — на сервере лучше PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://golf:golf@db:5432/golf
DATABASE_URL=sqlite:////data/golf.db

# Club label
CLUB_NAME=МГГК · Крылатское

# Comma-separated list of origins allowed to hit the API. Production value should
# be your actual domain(s) only.
CORS_ORIGINS=https://golf.example.com

# Cookie / JWT
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
JWT_EXPIRE_MINUTES=480
